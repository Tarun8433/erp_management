{
  "permissions": {
    "allow": [
      "Read",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(flutter --version)",
      "Bash(dart --version)",
      "Bash(npm run dev)",
      "Bash(npm run start)",
      "Bash(npm start)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm audit)",
      "Bash(node *)",
      "Bash(nodemon *)",
      "Bash(flutter pub get)",
      "Bash(flutter pub upgrade --dry-run)",
      "Bash(flutter analyze)",
      "Bash(flutter test)",
      "Bash(flutter test *)",
      "Bash(flutter run)",
      "Bash(flutter run *)",
      "Bash(flutter build apk *)",
      "Bash(flutter build ios *)",
      "Bash(flutter clean)",
      "Bash(flutter format *)",
      "Bash(dart format *)",
      "Bash(dart analyze)",
      "Bash(dart fix --apply)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git stash list)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(unzip *)",
      "Bash(mongosh *)",
      "Bash(mongodump *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*/.env)",
      "Read(*/.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*firebase-adminsdk*)",
      "Read(*service-account*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Bash(rm -rf *)",
      "Bash(rm -f *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(flutter pub publish)",
      "Bash(mongosh * --eval * drop*)",
      "Bash(* dropDatabase *)",
      "Bash(* dropCollection *)"
    ],
    "additionalDirectories": [
      "./backend",
      "./gold",
      "./gold_admin"
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "FLUTTER_APP": "gold"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "command": "code-review-graph update --quiet --skip-flows",
        "timeout": 5000
      }
    ],
    "SessionStart": [
      {
        "command": "code-review-graph status --json",
        "timeout": 3000
      }
    ],
    "PreCommit": [
      {
        "command": "code-review-graph detect-changes --brief",
        "timeout": 10000
      }
    ]
  }
}
